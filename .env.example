# ---- SERV Reasoning (required for the real bot brain) ----
# Get a key at https://console.openserv.ai/
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# SERV_BASE_URL=https://inference-api.openserv.ai/v1

# ---- Kite payments ----
# mock  = simulated ledger (default, for local dev)
# kpass = Kite Passport CLI (`kpass wallet send`); install: curl -fsSL https://cli.gokite.ai/install.sh | bash
# chain = direct pieUSD transfer on Kite testnet from KITE_PRIVATE_KEY (faucet: https://faucet.gokite.ai/)
KITE_MODE=mock
KITE_ASSET=USDC
# KITE_PRIVATE_KEY=0x...
# KITE_TOKEN_ADDRESS=0x38129cf4CE5E183eFF248F42A7D345Bb1B47621A
# KITE_TOKEN_DECIMALS=18
# KITE_RPC_URL=https://rpc-testnet.gokite.ai/
# KITE_EXPLORER=https://testnet.kitescan.ai
BOT_DAILY_CAP=50

# ---- Reppo Evaluation API (optional; evals are PUBLIC, transcripts are anonymized) ----
# Get a key at https://eval.reppo.xyz -> API Key
REPPO_API_KEY=
REPPO_SETTLEMENT_MINUTES=10

# ---- Game tuning ----
CHAT_SECONDS=120
VOTE_SECONDS=30
MAX_ROUNDS=2
MIN_PLAYERS=3
BOT_STAKE=1
BRIBE_MAX=0.5
BRIBE_BUDGET=1
PORT=3001

# ---- Production ----
# Postgres connection string. When set, games, players and lessons are stored in the database
# instead of data/store.json.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Public address of the deployment (enables the keep-alive). Render sets this automatically.
# PUBLIC_URL=https://your-app.example.com
# Ceilings that protect your credits on a public deployment.
MAX_GAMES_PER_DAY=200
MAX_ROOMS=40
ROOMS_PER_IP_PER_HOUR=8
